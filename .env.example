# Copy to .env and fill in. Every variable below is read from server/src/config.ts unless noted.
# Comments sit on their own lines on purpose: an empty value for an enum or number (SEARCH_PROVIDER=, EMBEDDING_DIM=)
# is a boot error, so leave optional lines commented out instead of blank.

# ---- Core -------------------------------------------------------------------
# Postgres with the pgvector extension. Docker Compose overrides this to point at its own postgres service.
DATABASE_URL=postgres://brain:brain@localhost:5432/brain
# Public base URL users and Slack reach. Must be https:// when NODE_ENV=production (the Docker image sets it).
PUBLIC_URL=http://localhost:3000
# HTTP port inside the process (default 3000).
# PORT=3000
# Host port for Docker Compose. Keep the app bound to localhost behind a reverse proxy.
# APP_PORT=3000
# Host port for the Compose Postgres service (localhost only).
# POSTGRES_PORT=5432
# Required in production: 32 random bytes, base64 (openssl rand -base64 32). Encrypts every stored token. Losing it invalidates them.
ENCRYPTION_KEY=
# Required in production for the first-owner claim. Keep private; production logs never print it.
# Generate with: openssl rand -hex 24
SETUP_TOKEN=

# ---- Slack ------------------------------------------------------------------
# socket (default, needs SLACK_APP_TOKEN, no public request URL) or http (needs a public PUBLIC_URL and SLACK_SIGNING_SECRET).
# SLACK_MODE=socket
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Required when SLACK_MODE=socket. App-level token (xapp-...) with connections:write.
SLACK_APP_TOKEN=
# Required when SLACK_MODE=http.
SLACK_SIGNING_SECRET=
# Pins this deployment to one workspace (T...). Sign-in and install from any other team are refused.
# SLACK_TEAM_ID=
# Override the Slack Web API base URL used for bot calls (GovSlack, test doubles). OAuth/sign-in still use slack.com.
# SLACK_API_URL=https://slack.com/api/

# ---- Chat model -------------------------------------------------------------
# Provider is inferred from the key prefix: sk-ant- Anthropic, AIza Google, xai- xAI, anything else OpenAI.
MODEL_API_KEY=
# To use Google Vertex AI with an ADC authorized-user JSON file, set these values and use docker-compose.vertex.yml.
# MODEL_PROVIDER=vertex
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# GOOGLE_VERTEX_PROJECT=your-google-cloud-project-id
# GOOGLE_VERTEX_LOCATION=global
# GOOGLE_VERTEX_EMBED_LOCATION=us-central1
# GOOGLE_VERTEX_EMBED_MODEL=gemini-embedding-001
# Set BOTH to use any OpenAI-compatible endpoint (OpenRouter, Ollama, vLLM). MODEL_NAME is required with MODEL_BASE_URL.
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1
# Roles (main, triage, extract, summarize, research), profile and override are admin settings in Configure > Models (stored in the DB).
# Env fallback used when the admin has not set one: "provider:model", e.g. anthropic:claude-sonnet-4-5 or compat:model.
# MODEL_FALLBACK=
# Fallback key: provider key vars are ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, XAI_API_KEY.
# FALLBACK_MODEL_API_KEY=
# Base URL for a compat fallback (provider "compat").
# FALLBACK_MODEL_BASE_URL=

# ---- Embeddings -------------------------------------------------------------
# Falls back to MODEL_API_KEY when unset. Not required if EMBEDDING_BASE_URL is set (local servers need no key).
# A blank line here would NOT fall back (empty string is not "unset"), so keep it commented unless you set a value.
# EMBEDDING_API_KEY=
# OpenAI-compatible base (e.g. Ollama http://localhost:11434/v1). When set, the chat key is never sent here.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=text-embedding-3-small
# Vector size (1..2000). Fixed per database: changing it after data exists is refused; re-embed to switch models.
# EMBEDDING_DIM=1536

# ---- Web search (optional) --------------------------------------------------
# tavily | brave | firecrawl. Unset = web search is off for every turn.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# ---- Database pools ---------------------------------------------------------
# Query pool (default 20, min 2). Lock pool holds one session advisory lock per running turn or memory write (default 25, min 2).
# Postgres max_connections must cover both pools plus the job queue's pool.
# DB_POOL_MAX=20
# DB_LOCK_POOL_MAX=25

# ---- Integrations (optional, each enables its sync source and connectors) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
