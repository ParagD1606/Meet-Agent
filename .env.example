DATABASE_URL=postgres://brain:brain@localhost:5432/brain
PUBLIC_URL=http://localhost:3000
ENCRYPTION_KEY=            # 32 bytes, base64 (openssl rand -base64 32)
SLACK_MODE=socket          # socket | http
MODEL_API_KEY=             # anthropic | openai | google | xai key (provider inferred)
MODEL_BASE_URL=            # optional OpenAI-compatible endpoint (OpenRouter, Ollama)
EMBEDDING_API_KEY=         # defaults to MODEL_API_KEY if openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MODEL_NAME=                # required with MODEL_BASE_URL
# Slack (http mode needs SIGNING_SECRET; socket mode needs APP_TOKEN)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Optional integrations
SEARCH_PROVIDER=           # tavily | brave | firecrawl
SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
