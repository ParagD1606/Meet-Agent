{"id": "ex-01", "visibility": "public", "messages": [{"user": "Asha Verma", "ts": "2026-03-03T10:02:00Z", "text": "Quick sync on sales tax for the Marigold billing rewrite. Avalara quoted us 18k a year, Stripe Tax is 0.5% of volume"}, {"user": "Tomasz Kowalski", "ts": "2026-03-03T10:05:00Z", "text": "at our volume that is about 9k. I vote Stripe Tax, one less vendor to integrate"}, {"user": "Asha Verma", "ts": "2026-03-03T10:07:00Z", "text": "agreed. Decision: we go with Stripe Tax for Marigold, no Avalara"}], "expect": [{"tokens": ["Stripe Tax", "Marigold"], "kind": "decision"}], "forbid": [{"tokens": ["Avalara", "chosen"], "why": "rejected option stated as chosen"}], "noFacts": false, "tags": ["decision"]}
{"id": "ex-02", "visibility": "public", "messages": [{"user": "Leila Haddad", "ts": "2026-03-10T14:11:00Z", "text": "re: the Kiln data pipeline. Do we keep Airflow or move to Dagster?"}, {"user": "Ravi Menon", "ts": "2026-03-10T14:13:00Z", "text": "I'd move. Airflow upgrades are eating a sprint every quarter"}, {"user": "Leila Haddad", "ts": "2026-03-10T14:20:00Z", "text": "ok, we are moving the Kiln pipeline to Dagster. Ravi owns the migration plan"}], "expect": [{"tokens": ["Dagster", "Kiln"], "kind": "decision"}, {"tokens": ["Ravi Menon", "migration"], "kind": "owner"}], "forbid": [], "noFacts": false, "tags": ["decision", "owner"]}
