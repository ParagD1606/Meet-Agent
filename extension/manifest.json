{
  "manifest_version": 3,
  "name": "Brain Meeting Notes",
  "version": "0.11.0",
  "description": "A live side panel for Meet, Teams, Zoom and Slack calls: follow the transcript, review detected tasks and decisions, ask questions, and send approved notes to Brain.",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/wc/*",
    "https://app.zoom.us/*",
    "https://app.slack.com/*",
    "https://slack.derpx06.live/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Brain Meeting Notes"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*",
        "https://app.zoom.us/*",
        "https://app.slack.com/*"
      ],
      "js": [
        "lib.js",
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}